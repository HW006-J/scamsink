# ScamSink — voice-server (persistent ConversationRelay WebSocket process).
# Deploys to Railway/Render/Fly — NOT Vercel (needs a long-lived connection).
# Copy to .env for local development. Never commit real values.

# Same Neon Postgres connection string as the Next.js app's DATABASE_URL.
DATABASE_URL=postgres://user:password@ep-example-000000.us-east-2.aws.neon.tech/scamsink?sslmode=require

# Twilio auth token, used to validate that inbound requests are genuinely
# from Twilio. Same value as the Next.js app's TWILIO_AUTH_TOKEN.
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Public URL of the Next.js app (used for reference/logging).
PUBLIC_APP_URL=https://your-app.vercel.app

# Must exactly match the Next.js app's VOICE_SERVER_SHARED_SECRET.
VOICE_SERVER_SHARED_SECRET=replace_with_a_long_random_value

# LLM provider for the voice persona. Groq is the production default: it's
# the fastest first-token latency available for a live phone call, and its
# free tier (30 req/min, 8K tokens/min for openai/gpt-oss-20b) comfortably
# covers one call's worth of turns. Get a key at https://console.groq.com.
AI_PROVIDER=groq
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=openai/gpt-oss-20b

# Optional fallback/legacy provider — only used if AI_PROVIDER=anthropic.
# Not required for the Groq production path.
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-haiku-4-5

# Port the WebSocket/HTTP server listens on (Railway/Render/Fly set $PORT for you).
PORT=8080
