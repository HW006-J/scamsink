# ScamSink — Next.js app (dashboard + API routes). Deploys to Vercel.
# Copy to .env.local for local development. Never commit real values.

# Neon Postgres connection string (with sslmode=require).
DATABASE_URL=postgres://user:password@ep-example-000000.us-east-2.aws.neon.tech/scamsink?sslmode=require

# Twilio account credentials (Console > Account > API keys & tokens).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# The ScamSink inbound number, in E.164 format. Shown on the dashboard/demo page.
TWILIO_PHONE_NUMBER=+15551234567

# Public URL this app is deployed at (used to validate Twilio webhook
# signatures, which are computed against the exact external URL Twilio POSTs
# to — e.g. https://scamsink.vercel.app).
PUBLIC_APP_URL=https://your-app.vercel.app

# Base wss:// URL of the persistent voice-server (Railway/Render/Fly), e.g.
# wss://scamsink-voice.up.railway.app/relay — see voice-server/.env.example.
VOICE_SERVER_URL=wss://your-voice-server.example.com/relay

# Shared secret used to sign/verify the short-lived per-call token embedded
# in the ConversationRelay URL. Must match voice-server's copy exactly.
# Generate with: openssl rand -hex 32
VOICE_SERVER_SHARED_SECRET=replace_with_a_long_random_value

# --- Infrastructure-simulation demo mode (optional) ---
# This is the only call flow the product has: an operator types a phone
# number on the dashboard and presses "Start call". ScamSink calls that
# number using TWILIO_PHONE_NUMBER as caller ID, then runs the deterministic
# CRITICAL INFRASTRUCTURE SIMULATION script through ConversationRelay.
# DEMO_PHONE_NUMBER and DEMO_OPERATOR_SECRET must both be set for the form
# to appear; if either is missing it's hidden. A genuine inbound call to
# TWILIO_PHONE_NUMBER (someone dialing it directly) always gets a safe,
# non-interactive hangup instead — see app/api/twilio/voice/route.ts.
# Your own phone, in E.164 format — never exposed to the browser. Always
# implicitly allowed as a destination, even if omitted from the allowlist
# below.
DEMO_PHONE_NUMBER=+447700900000
# Passphrase the operator enters once in the browser to authorize a call.
# Choose your own value — never committed, never printed by ScamSink.
DEMO_OPERATOR_SECRET=choose_a_passphrase_only_you_know
# Comma-separated E.164 numbers the dashboard is allowed to dial, on top of
# DEMO_PHONE_NUMBER above. This is a hard server-side allowlist — the client
# can type any number it wants, but only numbers listed here (or
# DEMO_PHONE_NUMBER) will ever actually be dialed. Optional; if unset, only
# DEMO_PHONE_NUMBER is dialable.
DEMO_ALLOWED_PHONE_NUMBERS=+447700900000,+447940757160
